+<translation id="1933341829955786215">ನೀವು aetherium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆ, <ph name="MANAGER" /> ಗೆ ಅಗತ್ಯವಿದೆ</translation>
+<translation id="193439633299369377">ಅಪ್‌ಡೇಟ್ ಅನ್ವಯಿಸಲು aetheriumOS ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
+<translation id="1951406923938785464">ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ aetherium ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
+<translation id="1953553007165777902">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="MINUTE" /> ನಿಮಿಷ(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ</translation>
