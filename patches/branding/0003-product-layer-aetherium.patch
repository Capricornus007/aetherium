+<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
+<translation id="1029669172902658969">‏راه‌اندازی مجدد برای به‌روزرسانی aetheriumOS</translation>
+<translation id="1040916596585577953">‏aetherium توصیه می‌کند این افزونه را بررسی کنید</translation>
+<translation id="1042552502243217427">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، aetherium از سرورهای Google استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Google متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
+<translation id="1051793555070215510">با تکمیل این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید «حالت ناشناس» را بهبود ببخشیم.</translation>
+<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
+<translation id="1083934481477628225">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای aetherium خاموش کرده است</translation>
+<translation id="109026165963220603">‏‫aetherium برای کاوش و استفاده از دستگاه‌های اطراف به دست‌یابی به شبکه محلی نیاز دارد</translation>
+<translation id="1090946077924227754">‏برای جستجو کردن افزونه یا ویژگی خاص aetherium، میان‌بر آن را در نوار نشانی تایپ کنید و به‌دنبال آن کلید صفحه‌کلید انتخابی‌تان را فشار دهید</translation>
+<translation id="1098493699368672217">‏نشان دادن جستجو با aetherium در سینی سیستم و روشن کردن میان‌بر صفحه‌کلید</translation>
+<translation id="1104942323762546749">‏aetherium می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
+<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE" /></translation>
+<translation id="113122355610423240">‏aetherium مرورگر پیش‌فرضتان است</translation>
+<translation id="1131805035311359397">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم aetherium وارد شوید<ph name="END_LINK" />.</translation>
+<translation id="1145158441928281100">{COUNT,plural, =1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، aetherium را راه‌اندازی مجدد کنید. پنجره «ناشناس» یا «مجزا» باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهد شد.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، aetherium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، aetherium را راه‌اندازی مجدد کنید. ‫# پنجره «ناشناس» و «مجزا» در نمایه‌های مختلف باز است. بعداز راه‌اندازی مجدد، دوباره باز نخواهند شد.}}</translation>
