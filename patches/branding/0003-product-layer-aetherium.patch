+<!DOCTYPE translationbundle>
+<translationbundle lang="ml">
+<translation id="130631256467250065">നിങ്ങൾ അടുത്ത തവണ ഉപകരണം റീസ്റ്റാർട്ട് ചെയ്യുമ്പോൾ മാറ്റങ്ങൾ പ്രാബല്യത്തിൽ വരും.</translation>
+<translation id="1965068424387304464">aetherium നുറുങ്ങ്: പാസ്‌വേഡുകൾ സംരക്ഷിക്കൂ</translation>
+<translation id="261308610302996111">aetherium മെനു &gt;
+          <ph name="SETTINGS_TITLE" />
+          &gt;
+          <ph name="SYSTEM_TITLE" />
+          &gt;
+          <ph name="PROXIES_TITLE" />
+          എന്നിങ്ങനെ പോയി നിങ്ങളുടെ കോൺഫിഗറേഷൻ ''പ്രോക്‌സി അല്ല'' അല്ലെങ്കിൽ ''നേരിട്ട്'' എന്നതിലേക്ക് സജ്ജീകരിച്ചിട്ടുണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
+<translation id="275588974610408078">aetherium-ത്തിൽ ക്രാഷ് റിപ്പോർട്ടിംഗ് ലഭ്യമല്ല.</translation>
+<translation id="3064346599913645280">നിങ്ങൾ സുരക്ഷിതമായ ഒരു aetherium പേജാണ് കാണുന്നത്</translation>
+<translation id="3255926992597692024">പേയ്‌മെന്റ് രീതികൾ പൂരിപ്പിക്കുന്നതിനുള്ള ക്രമീകരണം പരിഷ്‌കരിക്കാൻ ശ്രമിക്കുകയാണ് aetherium.</translation>
