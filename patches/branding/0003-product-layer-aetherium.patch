+<translation id="1828328511398219809"><ph name="EXISTING_USER" /> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ವಿವರಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, aetherium ಗೆ ನಿಮ್ಮದೇ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS" /> ಆಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. <ph name="DEVICE" /> ನಿಂದ ನಿಮ್ಮ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸಹ ನೀವು ಪಡೆಯುತ್ತೀರಿ.</translation>
+<translation id="183031085822326697">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ನಲ್ಲಿ ನೀವು aetherium ಅನ್ನು ತೆರೆದಾಗ, Google Password Manager ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
+<translation id="1838374766361614909">ಹುಡುಕಾಟ ತೆರವುಗೊಳಿಸಿ</translation>
+<translation id="18552579716432081">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು Google ಖಾತೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡು, ಅದನ್ನು ಈ ಸಾಧನದಿಂದ ಮಾತ್ರ ಅಳಿಸಲು, <ph name="BEGIN_LINK" />aetherium ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ<ph name="END_LINK" />.</translation>
+<translation id="1857749206890802997">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಹೊಸ ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ತೆರೆಯಲು ಅಥವಾ ರಚಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ aetherium ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
+<translation id="185970820835152459">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ Google ಖಾತೆಗಳನ್ನು ನೀವು ನಿರ್ವಹಿಸಬಹುದು. ನಿಮ್ಮ Google ಖಾತೆಗಳನ್ನು aetherium ಬ್ರೌಸರ್, Play Store ‌‌, Gmail ಹಾಗೂ ಮುಂತಾದವುಗಳಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ. ಕುಟುಂಬದ ಸದಸ್ಯರಂತಹ ಬೇರೊಬ್ಬರಿಗೆ ನೀವು ಖಾತೆಯನ್ನು ಸೇರಿಸಲು ಬಯಸಿದರೆ, ಬದಲಿಗೆ ನಿಮ್ಮ <ph name="DEVICE_TYPE" /> ಗೆ ಹೊಸ ವ್ಯಕ್ತಿಯನ್ನು ಸೇರಿಸಿ. <ph name="LINK_BEGIN" />ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END" /></translation>
