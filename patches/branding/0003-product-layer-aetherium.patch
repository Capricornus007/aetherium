+<translation id="1026101648481255140">המשך בהתקנה</translation>
+<translation id="1029669172902658969">‏הפעלה מחדש לצורך עדכון ‎&amp;aetheriumOS</translation>
+<translation id="1040916596585577953">‏לפי המלצת aetherium, כדאי לבדוק את התוסף הזה</translation>
+<translation id="1042552502243217427">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת aetherium משתמשת בשרתי Google. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
+<translation id="1051793555070215510">מילוי הסקר הזה ייקח רק דקה ויעזור לנו לשפר את המצב הפרטי.</translation>
+<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
+<translation id="1083934481477628225">‏ההורה שלך השבית ב-aetherium את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
+<translation id="109026165963220603">‏כדי ש-aetherium יוכל למצוא מכשירים קרובים ולהשתמש בהם, צריך לתת לו גישה לרשת המקומית</translation>
+<translation id="1090946077924227754">‏כדי לחפש תכונה או תוסף ספציפיים של aetherium, אפשר להקליד את השם המקוצר שלהם בסרגל הכתובות ואז ללחוץ על מקש המקלדת שנבחר</translation>
+<translation id="1098493699368672217">‏הצגת החיפוש באמצעות aetherium במגש המערכת והפעלת מקשי הקיצור</translation>
+<translation id="1104942323762546749">‏aetherium רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
+<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE" /></translation>
