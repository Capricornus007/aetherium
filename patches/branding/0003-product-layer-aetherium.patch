+<translation id="9093206154853821181">{0,plural, =1{I-aetherium izoqalisa kabusha phakathi kwehora}one{I-aetherium izoqalisa kabusha emahoreni angu-#}other{I-aetherium izoqalisa kabusha emahoreni angu-#}}</translation>
+<translation id="9106236359747881194">Khetha umbhalo ozowusesha</translation>
+<translation id="9106612006984859720">Ukuze uthole izibuyekezo zesikhathi esizayo ze-aetherium, uzodinga i-Windows 10 noma yakamuva. Le khompyutha isebenzisa i-Windows 8.1.</translation>
+<translation id="91086099826398415">Vula isixhumanisi ku&amp;thebhu entsha ye-aetherium</translation>
+<translation id="911206726377975832">Phinda ususe idatha yakho yokudlulisa amehlo?</translation>
+<translation id="9134482777260927479">Usizo lomsebenzi wasekhaya</translation>
+<translation id="9148058034647219655">Phuma</translation>
+<translation id="9155105544013854680">Qhubeka lapho ogcine khona: Iaetherium ingabuyisela amathebhu akho njalo lapho uqala kabusha. Ukuze ukuvule lokhu, iya ku-</translation>
+<translation id="9158494823179993217">Umlawuli wesistimu yakho ulungise i-aetherium ukuthi ivule esinye isiphequluli ukufinyelela i-<ph name="TARGET_URL_HOSTNAME" />.</translation>
+<translation id="9185526690718004400">Qalisa kabusha ukuze ubuyekeze i-&amp;aetherium</translation>
+<translation id="9190841055450128916">I-aetherium (mDNS-In)</translation>
+<translation id="924957577793602335">Yenza i-aetherium Ibe ngeyakho</translation>
+<translation id="93478295209880648">I-aetherium kungenzeka ingasebenzi kahle ngoba ayisasekelwa ku-Windows XP noma ku-Windows Vista</translation>
+<translation id="945098430667185067">Thola izakhi zokuphepha ezihamba phambili zeGoogle usendleleni ngeaetherium.</translation>
+<translation id="945522503751344254">Thumela impendulo</translation>
+<translation id="965162752251293939">Ubani osebenzisa i-aetherium?</translation>
+<translation id="967427899662692980">Thola ukuvikeleka okuqine kakhulu kwe-aetherium</translation>
+<translation id="983803489796659991">Ukufaka kuhlulekile ngoba iseva yokubuyekeza ayinayo idatha ye-hash ye-application.</translation>
+<translation id="985498048907240953">Sebenzisa i-aetherium Ngaphandle kwe-Akhawunti</translation>
+<translation id="985602178874221306">Ababhali be-aetherium</translation>
+<translation id="989970834842471429">Khetha noma yimuphi umbhalo noma isithombe ukuze useshe Ngosesho Lomfanekiso</translation>
