+#endif
+#if defined(AETHERIUM_HEADLESS_OZONE_HAS_X11)
+        if (name == "x11") {
+          return true;
+        }
+#endif
+        return false;
+      };
+      std::string chosen = AETHERIUM_HEADLESS_OZONE_DEFAULT;
