diff --git a/chrome/browser/headless/BUILD.gn b/chrome/browser/headless/BUILD.gn
index 424a139c56232..2bd18b2a1af5c 100644
--- a/chrome/browser/headless/BUILD.gn
+++ b/chrome/browser/headless/BUILD.gn
@@ -27,6 +27,23 @@ source_set("initializer") {
     "headless_mode_platform.h",
   ]
 
+  # aetherium: upstream hard-codes --ozone-platform=headless on Linux, which
+  # aborts at startup (ui/ozone/platform_selection.cc LOG(FATAL)) when that
+  # platform is not compiled in. Pass down what this build actually contains so
+  # headless mode can follow the running session instead.
+  defines = [
+    "AETHERIUM_HEADLESS_OZONE_DEFAULT=\"" + ozone_platform + "\"",
+  ]
+  if (ozone_platform_headless) {
+    defines += [ "AETHERIUM_HEADLESS_OZONE_HAS_HEADLESS" ]
+  }
+  if (ozone_platform_x11) {
+    defines += [ "AETHERIUM_HEADLESS_OZONE_HAS_X11" ]
+  }
+  if (ozone_platform_wayland) {
+    defines += [ "AETHERIUM_HEADLESS_OZONE_HAS_WAYLAND" ]
+  }
+
   if (is_mac) {
     sources += [ "headless_mode_platform_mac.mm" ]
   }
